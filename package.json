{
  "name": "calificaya-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:backup": "node backend/db/backup-dump.js",
    "db:migrate": "node backend/db/runMigrations.js",
    "db:restore": "node backend/db/restore-dump.js",
    "db:restore:drill": "node backend/db/restore-drill.js",
    "db:seed": "node backend/db/seed.js",
    "dev": "vite",
    "dev:api": "node backend/server.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "migrate:db": "node backend/db/runMigrations.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "npm run lint && npm run test:ci && npm run test:e2e",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "vite": "^5.4.11",
    "vitest": "^3.0.9"
  }
}
